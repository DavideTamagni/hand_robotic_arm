      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/upper_arm_link.dae" />
      </geometry>
    </collision>
  </link>
  <joint name="shoulder_joint" type="revolute">
    <origin xyz="0 0 0.07" rpy="1.5708 -1.5708 0" />
    <parent link="shoulder_Link" />
    <child link="upper_arm_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="30.0" velocity="2.0" />
  </joint>
  <link name="elbow_link">
    <inertial>
      <origin xyz="0.023288 9.5152E-09 -1.4756E-08" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.00077493" ixy="2.5638E-10" ixz="1.0064E-10" iyy="0.0015149" iyz="-5.3558E-10" izz="0.0016544" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
