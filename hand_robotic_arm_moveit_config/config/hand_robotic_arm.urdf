      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/rotating_forearm_link.dae" />
      </geometry>
    </collision>
  </link>
  <joint name="rotating_forearm_joint" type="revolute">
    <origin xyz="0.09 0 0" rpy="1.5708 0 1.5708" />
    <parent link="elbow_link" />
    <child link="rotating_forearm_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1416" upper="3.1416" effort="15.0" velocity="2.0" />
  </joint>
  <link name="wrist_link">
    <inertial>
      <origin xyz="-7.6511E-19 3.5321E-20 0.016292" rpy="0 0 0" />
      <mass value="0.25" />
      <inertia ixx="3.5429E-05" ixy="-5.2426E-14" ixz="4.2565E-21" iyy="3.8063E-05" iyz="-4.5053E-23" izz="4.2219E-05" />
