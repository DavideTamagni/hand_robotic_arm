  <joint name="little_finger_joint" type="revolute">
    <origin xyz="0.079947 0.036465 -0.00063771" rpy="-1.4486 0 0.18237" />
    <parent link="palm_link" />
    <child link="little_finger_link" />
    <axis xyz="0 0 1" />
    <limit lower="-0.7854" upper="0.3" effort="5.0" velocity="2.0" />
    <mimic joint="thumb_joint" multiplier="1.5" offset="-0.5" />
  </joint>


  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <parameters>@CONTROLLER_CONFIG_PATH@</parameters>
    </plugin>
  </gazebo>


  
  <!-- The Arm Pipeline -->
  <ros2_control name="hand_robotic_arm" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="base_joint">
      <command_interface name="position"/>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="shoulder_joint">
      <command_interface name="position"/>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="rotating_forearm_joint">
      <command_interface name="position"/>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="wrist_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="wrist_yaw_joint">
      <command_interface name="position"/>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <!-- Active Thumb Elements -->
    <joint name="thumb_base_joint">
      <command_interface name="position"/>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="thumb_joint">
      <command_interface name="position"/>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
  
</robot>
