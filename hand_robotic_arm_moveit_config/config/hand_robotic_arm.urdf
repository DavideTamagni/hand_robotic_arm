      <material name="white_metal">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/middle_finger_link.dae" />
      </geometry>
    </collision>
  </link>
  <joint name="middle_finger_joint" type="revolute">
    <origin xyz="0.095 -0.012227 -0.0027801" rpy="-1.6232 0 0" />
    <parent link="palm_link" />
    <child link="middle_finger_link" />
    <axis xyz="0 0 1" />
    <limit lower="-0.7854" upper="0.3" effort="5.0" velocity="2.0" />
    <mimic joint="thumb_joint" multiplier="1.5" offset="-0.5" />
  </joint>
  <link name="ring_finger_link">
    <inertial>
      <origin xyz="0.040199 -0.0072555 1.9138E-07" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia ixx="3.4344E-06" ixy="4.7881E-06" ixz="9.1114E-11" iyy="1.5227E-05" iyz="1.1126E-10" izz="1.7874E-05" />
    </inertial>
