<?xml version='1.0' encoding='utf-8'?>
<robot name="hand_robotic_arm">

  <!-- Define the absolute stationary simulation anchor point -->
  <link name='world'/>
  <!-- 2. Securely anchor the base_link so it can never fly or float away -->
  <joint name="world_fixed_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="3.5" />
      <inertia ixx="0.033355" ixy="-1.1146E-19" ixz="-5.3693E-18" iyy="0.033355" iyz="-1.9982E-18" izz="0.032476" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.97" rpy="0.12 -1.71 0" />
      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/base_link.dae" />
      </geometry>
      <material name="silver_metal">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/base_link.dae" />
      </geometry>
    </collision>
  </link>
  <link name="shoulder_Link">
    <inertial>
      <origin xyz="2.0919E-08 6.0613E-10 0.054476" rpy="0 0 0" />
      <mass value="3" />
      <inertia ixx="0.013122" ixy="5.3355E-08" ixz="-6.1911E-09" iyy="0.00743" iyz="4.0752E-09" izz="0.01369" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/shoulder_Link.dae" />
      </geometry>
      <material name="white_metal">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/shoulder_Link.dae" />
      </geometry>
    </collision>
  </link>
  <joint name="base_joint" type="revolute">
    <origin xyz="0 0 0.18" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="shoulder_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1416" upper="3.1416" effort="20.0" velocity="2.0" />
  </joint>
  <link name="upper_arm_link">
    <inertial>
      <origin xyz="0.12196 3.5788E-08 -5.2591E-08" rpy="0 0 0" />
      <mass value="1.5" />
      <inertia ixx="0.0040068" ixy="-4.5268E-10" ixz="-1.7075E-08" iyy="0.031511" iyz="1.5401E-09" izz="0.031003" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/upper_arm_link.dae" />
      </geometry>
      <material name="silver_metal">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
