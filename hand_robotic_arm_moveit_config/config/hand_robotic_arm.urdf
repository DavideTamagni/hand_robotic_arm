  <joint name="ring_finger_joint" type="revolute">
    <origin xyz="0.090019 0.012202 -0.0027908" rpy="-1.5184 0 0.10658" />
    <parent link="palm_link" />
    <child link="ring_finger_link" />
    <axis xyz="0 0 1" />
    <limit lower="-0.7854" upper="0.3" effort="5.0" velocity="2.0" />
    <mimic joint="thumb_joint" multiplier="1.5" offset="-0.5" />
  </joint>
  <link name="little_finger_link">
    <inertial>
      <origin xyz="0.030165 -0.0058374 -1.139E-06" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia ixx="1.3995E-06" ixy="1.7603E-06" ixz="1.2671E-10" iyy="5.4355E-06" iyz="1.7757E-11" izz="6.4656E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/little_finger_link.dae" />
      </geometry>
      <material name="white_metal">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
