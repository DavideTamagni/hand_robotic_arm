  </link>
  <joint name="thumb_base_joint" type="revolute">
    <origin xyz="0.018015 -0.037884 0.0095962" rpy="-2.8798 -0.84268 0" />
    <parent link="palm_link" />
    <child link="thumb_base_link" />
    <axis xyz="0 0 -1" />
    <limit lower="-0.6550" upper="0.2618" effort="5.0" velocity="2.0" />
  </joint>
  <link name="thumb_link">
    <inertial>
      <origin xyz="0.046163 0.0054946 0.0054988" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia ixx="4.8817E-06" ixy="-5.5267E-06" ixz="-5.5344E-06" iyy="2.9573E-05" iyz="-1.2644E-06" izz="2.9484E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
