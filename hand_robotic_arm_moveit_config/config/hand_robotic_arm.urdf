        <mesh filename="package://hand_robotic_arm/meshes/thumb_link.dae" />
      </geometry>
      <material name="white_metal">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/thumb_link.dae" />
      </geometry>
    </collision>
  </link>
  <joint name="thumb_joint" type="revolute">
    <origin xyz="0.0125 0 0" rpy="1.5708 0 0" />
    <parent link="thumb_base_link" />
    <child link="thumb_link" />
    <axis xyz="0 0 -1" />
    <limit lower="-0.1221" upper="0.5236" effort="5.0" velocity="2.0" />
  </joint>
  <link name="index_finger_link">
    <inertial>
      <origin xyz="0.036147 -0.0057548 1.547E-05" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia ixx="3.123E-06" ixy="4.4179E-06" ixz="2.4489E-09" iyy="1.6227E-05" iyz="8.7394E-09" izz="1.8353E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/index_finger_link.dae" />
      </geometry>
      <material name="white_metal">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/index_finger_link.dae" />
      </geometry>
    </collision>
  </link>
  <joint name="index_finger_joint" type="revolute">
    <origin xyz="0.087991 -0.037884 -0.00040381" rpy="-1.7104 0 -0.089934" />
    <parent link="palm_link" />
    <child link="index_finger_link" />
    <axis xyz="0 0 1" />
    <limit lower="-0.7854" upper="0.3" effort="5.0" velocity="2.0" />
    <mimic joint="thumb_joint" multiplier="1.5" offset="-0.5" />
  </joint>
  <link name="middle_finger_link">
    <inertial>
      <origin xyz="0.040005 -0.0065187 1.8951E-06" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia ixx="4.1324E-06" ixy="5.9811E-06" ixz="-1.5359E-09" iyy="2.0605E-05" iyz="-2.1921E-09" izz="2.3651E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/middle_finger_link.dae" />
