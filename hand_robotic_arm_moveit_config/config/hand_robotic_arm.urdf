    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://hand_robotic_arm/meshes/wrist_link.dae" />
      </geometry>
    </collision>
  </link>
  <joint name="wrist_fixed_joint" type="fixed">
    <origin xyz="0 0 0.2" rpy="0 0 0" />
    <parent link="rotating_forearm_link" />
    <child link="wrist_link" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="wrist_yaw_virtual_link">
    <inertial>
      <origin xyz="0.046399 0.0013147 -0.0028834" rpy="0 0 0" />
      <mass value="1E-05" />
      <inertia ixx="1E-05" ixy="0" ixz="0" iyy="1E-05" iyz="0" izz="1E-05" />
    </inertial>
  </link>
  <joint name="wrist_pitch_joint" type="revolute">
    <origin xyz="0 0 0.04" rpy="1.5708 -1.5708 0" />
    <parent link="wrist_link" />
    <child link="wrist_yaw_virtual_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="2.0" />
  </joint>
  <link name="palm_link">
    <inertial>
      <origin xyz="0.046399 -0.0028834 -0.0013147" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.000115" ixy="-6.5377E-07" ixz="6.2369E-06" iyy="0.0001406" iyz="4.0229E-06" izz="0.00023793" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
