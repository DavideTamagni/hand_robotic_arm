    <axis xyz="0 0 1" />
    <limit lower="-0.5236" upper="0.5236" effort="10.0" velocity="2.0" />
  </joint>
  <link name="thumb_base_link">
    <inertial>
      <origin xyz="0.0016891 6.0951E-10 5.9436E-09" rpy="0 0 0" />
      <mass value="0.03" />
      <inertia ixx="1.0697E-06" ixy="-5.2324E-14" ixz="-1.6946E-12" iyy="1.6045E-06" iyz="-8.2241E-15" izz="1.3488E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
