    <parent link="upper_arm_link" />
    <child link="elbow_link" />
    <axis xyz="0 0 1" />
    <limit lower="-2.3562" upper="2.3562" effort="25.0" velocity="2.0" />
  </joint>
  <link name="rotating_forearm_link">
    <inertial>
      <origin xyz="-8.0639E-19 -1.008E-35 0.099953" rpy="0 0 0" />
      <mass value="0.9" />
      <inertia ixx="0.0037481" ixy="-3.5609E-37" ixz="-4.303E-20" iyy="0.0037481" iyz="-6.9601E-36" izz="0.00080351" />
